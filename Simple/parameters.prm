subsection Rectangular mesh
  set x size = 42.0
  set y size = 42.0
  set z size = 10.0
  set periodic x = false
  set periodic y = false
  set periodic z = false
  set x subdivisions = 1
  set y subdivisions = 1
end

set global refinement = 8
set mesh adaptivity   = false

set time step = 2e-6
set number steps = 1000000

subsection output
  set condition = LOG_SPACING
  set number = 100
  set file type = vtu
end

subsection boundary conditions: 0
  set variables = x2
  set conditions = Natural, Natural, Natural, Dirichlet
end

set Model constant deltaG0 = -1.0, DOUBLE
set Model constant D1 = 1, DOUBLE
set Model constant D1s = 10, DOUBLE
set Model constant D2 = 50, DOUBLE
set Model constant j0 = 1.1e-2, DOUBLE
set Model constant l_int = 1.5, DOUBLE
set Model constant x1_init = 0.2, DOUBLE
set Model constant x2_init = 0.05, DOUBLE
set Model constant epsilon = 1e-4, DOUBLE

set read initial conditions from file = false

subsection initial condition file 1
  set file name = dealloy_n.in
  set dataset format = flat_binary
  set file variable names = n
  set simulation variable names = n
  set data points in x direction = 257
  set data points in y direction = 257
  set data points in z direction = 257
end

subsection initial condition file 2
  set file name = dealloy_x1.in
  set dataset format = flat_binary
  set file variable names = x1
  set simulation variable names = x1
  set data points in x direction = 257
  set data points in y direction = 257
  set data points in z direction = 257
end

subsection initial condition file 3
  set file name = dealloy_x2.in
  set dataset format = flat_binary
  set file variable names = x2
  set simulation variable names = x2
  set data points in x direction = 257
  set data points in y direction = 257
  set data points in z direction = 257
end
