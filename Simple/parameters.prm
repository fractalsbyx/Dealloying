subsection Rectangular mesh
  set x size = 48
  set y size = 48
  set z size = 100.0
  set periodic x = false
  set periodic y = false
  set periodic z = false
end

set global refinement = 8
set max refinement    = 8
set min refinement    = 3
set mesh adaptivity   = false
set remeshing period  = 800

set time step = 5e-6
set number steps = 40000000

set read initial conditions from file = false

subsection initial condition file 1
  set file name = dealloy_phi.in
  set dataset format = flat_binary
  set file variable names = n
  set simulation variable names = n
  set data points in x direction = 129
  set data points in y direction = 129
  set data points in z direction = 129
end

subsection output
  set condition = LOG_SPACING
  set number = 80
  set file type = vtu
end

subsection boundary conditions: 0
  set variables = x2
  set conditions = Natural, Natural, Natural, Dirichlet
end

subsection refinement criterion: 0
  set type              = value

  set value lower bound = 0.001
  set value upper bound = 0.999
  set variables         = n
end

subsection refinement criterion: 1
  set type              = gradient

  set gradient lower bound = 0.0001
  set variables         = x1, x2
end
